DATABASE_URL=postgres://user:password@localhost:5432/fantasy_hockey_dev

AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# data.naturalstattrick.com bot-access key (see https://www.naturalstattrick.com/api.php)
NST_API_KEY=

# Yahoo Fantasy Sports API (see https://developer.yahoo.com/apps/) - connects
# a user's own Yahoo Fantasy league, separate from site sign-in (Google)
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Verifies requests to /api/cron/* actually came from Vercel's own cron
# trigger, not the public internet (see
# https://vercel.com/docs/cron-jobs/manage-cron-jobs#securing-cron-jobs) -
# Vercel sends this same value as the Authorization header automatically.
CRON_SECRET=

